<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Real, intentional use now: GPS position for the radar screen (opt-in tradeoff — never
         written to disk, latest-fix-only, expires from memory on its own). Requested on every
         OS version for that reason, not just the pre-Android-12 BLE-scan quirk. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Live-testing found GPS fixes going sparse/intermittent within seconds of the screen
         turning off, even with the mesh service in the foreground — Android 10+ treats
         "screen off" as background for location purposes regardless of a foreground service,
         unless the app separately holds this permission (requested as its own, later, optional
         step — see MainActivity.maybeRequestBackgroundLocation — since the OS requires it be
         asked for separately from ACCESS_FINE_LOCATION, never in the same request). A "no" here
         just means positions go stale faster with the screen off; the app is otherwise unaffected. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required alongside the service's foregroundServiceType="...|location" below on Android 14+
         (a service must declare, and hold the matching permission for, every foreground service
         type it actually uses) — see the ACCESS_BACKGROUND_LOCATION comment above for why. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A correctly-declared foreground service (see MeshService below) is Android's own guarantee
         against being killed in the background, but OEM battery managers (MIUI, Samsung, OnePlus,
         etc.) are well known to kill foreground services anyway regardless of correct API usage —
         this is what actually lets the user exempt the app from that, via MainActivity's one-time
         Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Opt-in only: requested the moment (and only if) someone taps the camera icon on the Join
         screen to scan a QR code, never at launch. App is fully usable without ever granting this —
         pasting/typing a code, tapping a mesh2007:// link, or having someone else's camera scan the
         QR *this* app displays all still work with zero camera access. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ACCESS_WIFI_STATE/CHANGE_WIFI_STATE/NEARBY_WIFI_DEVICES and the wifi.direct feature (Wi-Fi
         Direct evidence accelerator's own manifest entries) lived here through v0.7.15-dev —
         removed by decision 49 (docs/DECISIONS.md), Wi-Fi Direct's removal (PLAN-v2.md §4.3 item
         3). Not re-added speculatively for the still-unimplemented Wi-Fi Aware slice that item 3
         also names — that slice should check its own actual permission requirements against
         current Play policy when it's real, not inherit WFD's possibly-different ones now. BLE
         L2CAP CoC (decision 48), this item's own current bulk pipe, needs no Wi-Fi permission at
         all — it rides the existing Bluetooth permissions above. -->

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".MeshApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_real"
        android:label="@string/app_name_real"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:label="@string/app_name_real"
            android:icon="@mipmap/ic_launcher_real" />

        <!-- Real launcher identity: enabled by default, disable to switch to decoy -->
        <activity-alias
            android:name=".LauncherReal"
            android:targetActivity=".ui.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name_real"
            android:icon="@mipmap/ic_launcher_real">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mesh2007" android:host="join" />
            </intent-filter>
        </activity-alias>

        <!-- Decoy launcher identity library: all disabled by default, AppIdentity.setDecoyActive
             enables exactly one of these four (picked at random, once per install) plus disables
             LauncherReal and every other decoy — see AppIdentity.kt and strings.xml's decoy-name
             comment for why this is a small library, not one fixed identity. Each one is otherwise
             identical (same target, same intent-filters) — only label/icon differ. -->
        <activity-alias
            android:name=".LauncherDecoy"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name_decoy"
            android:icon="@mipmap/ic_launcher_decoy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mesh2007" android:host="join" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherDecoy2"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name_decoy2"
            android:icon="@mipmap/ic_launcher_decoy2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mesh2007" android:host="join" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherDecoy3"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name_decoy3"
            android:icon="@mipmap/ic_launcher_decoy3">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mesh2007" android:host="join" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherDecoy4"
            android:targetActivity=".ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name_decoy4"
            android:icon="@mipmap/ic_launcher_decoy4">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mesh2007" android:host="join" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ble.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- Lets GroupChatScreen's "tap to view" hand a received evidence file to whatever app the
             user has for viewing it (gallery, photo viewer), without exposing raw file:// paths or
             any other part of internal storage — only the app-private evidence/ subdirectory is
             shared, and only for as long as the OS-granted read permission on that one URI lasts. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
